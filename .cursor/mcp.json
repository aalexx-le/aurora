{
    "mcpServers": {
        "browser-tools": {
            "command": "npx @agentdeskai/browser-tools-mcp@1.2.0",
            "autoApprove": [
                "getConsoleErrors",
                "getConsoleLogs",
                "getConsoleWarnings"
            ],
            "timeout": 300
        },
        "vercel": {
			"command": "npx vercel-mcp VERCEL_API_KEY=your_vercel_api_key_here"
        },
        "mcp-installer": {
            "command": "npx",
            "args": [
                "@anaisbetts/mcp-installer"
            ]
        },
        "MCP Installer": {
            "command": "npx",
            "type": "stdio",
            "args": [
                "cursor-mcp-installer-free@0.1.3",
                "index.mjs"
            ]
        },
        "youtube": {
            "command": "npx -y",
            "args": [
                "@anaisbetts/mcp-youtube"
            ]
        },
        "git": {
            "command": "uvx",
            "args": [ 
                "mcp-server-git"
            ]
        },
        "github": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "your_github_token_here"
            }
        },
        "docker": {
            "command": "uvx",
            "args": [
                "docker-mcp"
            ]
        },
        "postgres": {
            "command": "npx @modelcontextprotocol/server-postgres postgresql://postgre:abcd1234@localhost:5432/xela"
        } 
    }
}