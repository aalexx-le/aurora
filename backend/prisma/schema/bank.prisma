model BankManager {
  id        String   @id @default(uuid())
  userId    Int
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  banks BankAccount[]
  user  User          @relation(fields: [userId], references: [id])

  autoBankManager AutoBankManager?
}

model AutoBankManager {
  id         String                    @id @default(uuid())
  apiKey     String
  thirdParty AutoBankManagerThirdParty @default(CASSO)

  bankManager   BankManager @relation(fields: [bankManagerId], references: [id])
  bankManagerId String      @unique
}

model BankAccount {
  id                 String                  @id @default(uuid())
  name               String
  bankManagerId      String
  accountName        String
  accountNumber      String
  balance            Float
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  fullName           String
  bankManager        BankManager             @relation(fields: [bankManagerId], references: [id])
  transactions       BankTransaction[]
  historicalBalances HistoricalBankBalance[]
}

model HistoricalBankBalance {
  time          DateTime
  balance       Float
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  @@unique([bankAccountId, time])
}

model BankTransaction {
  id          Int         @id @default(autoincrement())
  bankId      String
  amount      Float
  description String
  createdAt   DateTime    @default(now())
  spentAmount Float       @default(0)
  bank        BankAccount @relation(fields: [bankId], references: [id])
  expense     Expense[]
}

enum AutoBankManagerThirdParty {
  CASSO
}
