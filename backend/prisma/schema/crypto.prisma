model CryptoPortfolio {
  userId                 Int
  name                   String                    @default("")
  status                 PortfolioStatus           @default(ACTIVE)
  exchanges              Exchanges                 @default(BINANCE)
  tradingType            TradingType
  apiKey                 String
  secretKey              String
  updateTime             DateTime?
  id                     String                    @id @default(uuid())
  investmentCategoryName String?
  balances               AssetBalance[]
  user                   User                      @relation(fields: [userId], references: [id])
  historicalAssetProfits HistoricalAssetProfit[]
  historicalBalances     HistoricalCryptoBalance[]
  trades                 Trade[]

  passphrasePortfolio PassphraseCryptoPortfolio?

  // New fields for aggregation
  parentPortfolioId String?
  parentPortfolio   CryptoPortfolio?  @relation("AggregatedPortfolios", fields: [parentPortfolioId], references: [id])
  childPortfolios   CryptoPortfolio[] @relation("AggregatedPortfolios")
}

model PassphraseCryptoPortfolio {
  id                String          @id @default(uuid())
  cryptoPortfolioId String          @unique
  cryptoPortfolio   CryptoPortfolio @relation(fields: [cryptoPortfolioId], references: [id])
  passphrase        String
}

model CreatePortfolioExecution {
  id               Int                         @id @default(autoincrement())
  userId           Int
  currentStep      PortfolioCreationStep?
  currentMilestone PortfolioCreationMilestone?

  // Progress tracking
  progressPercent Int @default(0) @db.SmallInt

  // Error handling
  errorMessage   String?
  recoveryAction ErrorRecoveryAction?
  retryCount     Int                  @default(0) @db.SmallInt
  maxRetries     Int                  @default(3) @db.SmallInt

  // Context data
  exchangeType     Exchanges?
  executionContext Json? // Minimal context only

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id])
}

model AssetBalance {
  id                String          @id @default(uuid())
  assetInfoId       String
  balance           Float
  locked            Float
  cryptoPortfolioId String
  assetInfo         AssetInfo       @relation(fields: [assetInfoId], references: [id])
  cryptoPortfolio   CryptoPortfolio @relation(fields: [cryptoPortfolioId], references: [id])
}

model Trade {
  id                Int          @id @default(autoincrement())
  cryptoPortfolioId String
  assetInfoId       String

  price           Float
  qty             Float
  quoteQty        Float
  commission      Float
  commissionAsset String
  time            DateTime
  isBuyer         Boolean

  // Enhanced fields for precomputation
  orderId         String?         // Exchange-specific order ID
  symbol          String?         // Trading pair symbol (e.g., "BTCUSDT")
  side            String?         // "BUY" or "SELL"
  realizedPnl     Float?          // Realized P&L for this trade
  fees            Float?          // Total fees in base currency
  feeAsset        String?         // Asset used for fees

  cryptoPortfolio CryptoPortfolio @relation(fields: [cryptoPortfolioId], references: [id])
  assetInfo       AssetInfo       @relation(fields: [assetInfoId], references: [id])

}

model AssetInfo {
  id                String                  @id @default(uuid())
  name              String
  symbol            String
  category          String
  desc              String
  logo              String
  tag               String                  @default("")
  assetBalances     AssetBalance[]
  assetPrices       AssetPrice[]
  historicalProfits HistoricalAssetProfit[]
  trades            Trade[]
}

model AssetPrice {
  assetInfoId String
  interval    String
  open_time   DateTime
  close_time  DateTime
  openPrice   Float
  closePrice  Float
  highPrice   Float
  lowPrice    Float
  volume      Float
  assetInfo   AssetInfo @relation(fields: [assetInfoId], references: [id])

  @@unique([assetInfoId, open_time])
}

model HistoricalCryptoBalance {
  time              DateTime
  estimatedBalance  Float
  changePercent     Float
  changeBalance     Float
  cryptoPortfolioId String

  // Enhanced fields for precomputation
  totalValue           Float? // Total portfolio value in base currency
  totalPnl             Float? // Total portfolio P&L
  totalRealizedPnl     Float? // Total realized P&L
  totalUnrealizedPnl   Float? // Total unrealized P&L
  assetCount           Int? // Number of different assets
  diversificationScore Float? // Portfolio diversification metric
  riskScore            Float? // Portfolio risk score

  cryptoPortfolio CryptoPortfolio @relation(fields: [cryptoPortfolioId], references: [id])

  @@unique([cryptoPortfolioId, time])
}

model HistoricalAssetProfit {
  time                DateTime
  estimatedProfit     Float
  totalCostInQuoteQty Float
  remainingQty        Float
  assetInfoId         String
  cryptoPortfolioId   String

  // Enhanced fields for precomputation
  realizedPnl       Float? // Realized profit/loss
  unrealizedPnl     Float? // Unrealized profit/loss
  totalPnl          Float? // Total P&L (realized + unrealized)
  averageCostBasis  Float? // Average cost basis per unit
  currentPrice      Float? // Current market price
  percentageGain    Float? // Percentage gain/loss
  holdingPeriodDays Int? // Days held

  assetInfo       AssetInfo       @relation(fields: [assetInfoId], references: [id])
  cryptoPortfolio CryptoPortfolio @relation(fields: [cryptoPortfolioId], references: [id])

  @@unique([cryptoPortfolioId, assetInfoId, time])
}

enum PortfolioStatus {
  ACTIVE
  INACTIVE
}

enum ErrorRecoveryAction {
  RETRY_AUTOMATIC
  RETRY_MANUAL
  UPDATE_CREDENTIALS
  WAIT_RATE_LIMIT
  CHECK_PERMISSIONS
  CONTACT_SUPPORT
  ABORT
}

enum PortfolioCreationMilestone {
  // Success milestones
  INITIALIZED
  CREDENTIALS_VERIFIED
  EXCHANGE_CONNECTED
  ACCOUNT_FETCHED
  BALANCES_FETCHED
  PORTFOLIO_STORED
  COMPLETED

  // Error milestones
  VALIDATION_FAILED
  CREDENTIALS_FAILED
  CONNECTION_FAILED
  FETCH_FAILED
  STORAGE_FAILED
  TIMEOUT_FAILED
  RATE_LIMITED
  INSUFFICIENT_PERMISSIONS
  FAILED
}

enum PortfolioCreationStep {
  VALIDATION
  AUTHENTICATION
  BALANCE_RETRIEVAL
  SYMBOL_DISCOVERY
  TRADE_HISTORY_FETCH
  PRICE_HISTORY_FETCH
  PNL_CALCULATION
  ANALYTICS_CALCULATION
  DATABASE_STORAGE
  COMPLETION
}

enum TradingType {
  FUTURES
  SPOT
}

