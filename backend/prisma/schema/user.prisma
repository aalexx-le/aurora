model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  name              String?
  password          String
  otp               String?
  otpPurpose        OtpPurpose?
  bankManager       BankManager[]
  cryptoPortfolios  CryptoPortfolio[]
  createPortfolioExecutions CreatePortfolioExecution[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  events            Event[]
  eventRecurrences  EventRecurrence[]
  eventCategories   EventCategory[]
  memberships       MembershipSubscription[]  
  paymentMethods    PaymentMethod[]
}

enum OtpPurpose {
  VERIFY_ACCOUNT
  RESET_PASSWORD
}
